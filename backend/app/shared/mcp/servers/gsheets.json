{
  "mcpServers": {
    "gsheets": {
      "type": "stdio",
      "command": "python",
      "args": ["-m", "app.mcp_servers.gsheets_server"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS}",
        "SHEETS_SPREADSHEET_ID": "${SHEETS_SPREADSHEET_ID}",
        "SHEETS_RANGE": "${SHEETS_RANGE}"
      }
    }
  }
}
