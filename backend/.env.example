# Application
APP_NAME=OneForAll
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase (platform data: users, ai history, notifications, conversations)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Database (SQLAlchemy / Postgres)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/oneforall

# AI - Groq (Llama 3.3 70B)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_MAX_ITERATIONS=5
LLM_MAX_TOKENS=2048

# MCP - Google Sheets (source of truth for factory inventory)
# Servers are declared in app/shared/mcp/servers.json (Smithery HTTP).
MCP_SHEETS_SERVER_NAME=toolbox
MCP_SHEETS_URL=https://mcp.smithery.ai/<namespace>
MCP_SHEETS_TOKEN=<api-key>
MCP_TOOL_TIMEOUT_SECONDS=30

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# CORS
CORS_ORIGINS=["http://localhost:5173"]
