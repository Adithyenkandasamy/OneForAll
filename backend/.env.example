# Application
APP_NAME=OneForAll
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase (platform data: users, ai history, notifications, conversations)
# SUPABASE_URL is your Supabase Postgres DSN, e.g.
# postgresql://postgres:password@db.<project>.supabase.co:5432/postgres
# It is used by SQLAlchemy as the primary database (and to derive the REST URL).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Database (SQLAlchemy async DSN). Optional: when unset, SUPABASE_URL is used.
DATABASE_URL=

# AI - Groq (Llama 3.3 70B)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_MAX_ITERATIONS=5
LLM_MAX_TOKENS=2048

# MCP - Google Sheets (source of truth for factory inventory)
# Servers are declared in app/shared/mcp/servers.json (Smithery HTTP).
MCP_SHEETS_SERVER_NAME=toolbox
# Smithery API key (substituted into servers.json as ${SMITHIRY_AI})
SMITHIRY_AI=
# Smithery namespace, e.g. @your-org/google-sheets (substituted as ${SMITHIRY_SPACE})
SMITHIRY_SPACE=
MCP_TOOL_TIMEOUT_SECONDS=30

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# CORS
CORS_ORIGINS=["http://localhost:5173"]
