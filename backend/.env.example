# Application
APP_NAME=OneForAll 
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase (platform data: users, ai history, notifications, conversations)
# SUPABASE_URL is your Supabase Postgres DSN, e.g.
# postgresql://postgres:password@db.<project>.supabase.co:5432/postgres
# It is used by SQLAlchemy as the primary database (and to derive the REST URL).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Database (SQLAlchemy async DSN). Optional: when unset, SUPABASE_URL is used.
DATABASE_URL=

# AI - Groq (Llama 3.3 70B)
GROQ_API_KEY_INVENTORY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_MAX_ITERATIONS=5
LLM_MAX_TOKENS=2048

# MCP - Google Sheets (source of truth for factory inventory)
# Servers are declared one file per service in app/shared/mcp/servers/.
# MCP_SHEETS_SERVER_NAME selects the server used by the inventory agent.
MCP_SHEETS_SERVER_NAME=gsheets
# Local development: path to the service-account key file.
GOOGLE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json
# Vercel/serverless: paste the complete service-account JSON here instead of a path.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Inventory spreadsheet, injected into every sheets_* call
SHEETS_SPREADSHEET_ID=
SHEETS_RANGE=Inventory!A1:H1000
MCP_TOOL_TIMEOUT_SECONDS=30

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# CORS
CORS_ORIGINS=["http://localhost:5173"]
